# Copy this file to `.env.local` and fill in your real keys.
# `.env.local` is gitignored; this `.env.example` is safe to commit.
#
# EXPO_PUBLIC_ vars are readable by the app at runtime (process.env.EXPO_PUBLIC_*).
# NOTE: they are inlined into the JS bundle at build time, so they are NOT secret
# in a shipped app — fine for local dev, but a real product should proxy the key
# through a backend. At runtime the in-app Settings key (expo-secure-store) wins.

# 1. Gemini (PRIMARY): Document-capable (PDF / image / CSV / XLSX / DOCX import) and high-accuracy OCR.
# Get a key: https://aistudio.google.com -> API Keys
EXPO_PUBLIC_GEMINI_API_KEY=AIza_your_key_here
# Optional model override (defaults to gemini-3.1-flash-lite):
# EXPO_PUBLIC_GEMINI_MODEL=gemini-3.1-flash-lite

# 2. Groq (SECONDARY FALLBACK): Ultra-fast inference with generous free-tier rate limits.
# Get a free Groq key: https://console.groq.com -> API Keys
EXPO_PUBLIC_GROQ_API_KEY=gsk_your_key_here
# Optional model override (defaults to qwen/qwen3.6-27b):
# EXPO_PUBLIC_GROQ_MODEL=qwen/qwen3.6-27b

# 3. OpenRouter (TERTIARY FALLBACK): Multi-model safety net across free open-source models.
# Get a free OpenRouter key: https://openrouter.ai/keys
EXPO_PUBLIC_OPENROUTER_API_KEY=sk-or-v1-your_key_here
# Optional model override (defaults to openrouter/free):
# EXPO_PUBLIC_OPENROUTER_MODEL=openrouter/free

# 4. Google Drive cloud backup (Android only, OPTIONAL). Without this, Settings > Backup shows
# "Not configured yet" and the Connect button stays disabled — that is by design, not a bug.
# Setup (Google Cloud Console -> APIs & Services):
#   a. Enable the "Google Drive API" for the project.
#   b. OAuth consent screen: External, add scope .../auth/drive.appdata, add yourself as a
#      test user (the appdata scope is sensitive — verification is only needed to go public).
#   c. Credentials -> Create Credentials -> OAuth client ID -> Android.
#      Package name: com.yabg.pip   (the Play Store package = applicationId in build.gradle)
#      SHA-1: `keytool -list -v -keystore ~/.android/debug.keystore -alias androiddebugkey \
#              -storepass android -keypass android` (add your release keystore's SHA-1 too).
#   d. Open the new client -> Advanced Settings -> enable "Custom URI scheme".
#      Google blocks it by default for Android clients and the flow needs it; the redirect is
#      com.yabg.pip:/oauth2redirect (see src/lib/cloudBackup/googleAuth.ts).
#   e. Paste the client id below, then rebuild the app (`npm run android`) — EXPO_PUBLIC_ vars
#      are inlined at build time, so a Metro reload alone will not pick this up.
#      Do NOT run `expo prebuild --clean`: android/ is gitignored and hand-maintained (the
#      applicationId override and the app-icon activity-aliases would be wiped).
EXPO_PUBLIC_GOOGLE_DRIVE_CLIENT_ID=123456789-abcdef.apps.googleusercontent.com

# RevenueCat (Android). Dashboard -> Project settings -> API keys -> Google Play.
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_your_key_here

