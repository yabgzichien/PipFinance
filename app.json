{
  "expo": {
    "name": "Pip",
    "slug": "pip-expenses-tracker",
    "version": "1.0.8",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "pip",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "versionCode": 9,
      "adaptiveIcon": {
        "backgroundColor": "#1f8a5b",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [],
      "package": "com.yabg.pipexpensestracker"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Pip needs access to your photos so you can attach a transaction screenshot.",
          "cameraPermission": "Pip needs the camera so you can snap a receipt to log."
        }
      ],
      [
        "react-native-document-scanner-plugin",
        {
          "cameraPermission": "Pip needs the camera to scan your statement or receipt."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#ffffff"
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      "expo-font",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "StreakWidget",
              "label": "Pip Streak",
              "minWidth": "110dp",
              "minHeight": "40dp",
              "targetCellWidth": 2,
              "targetCellHeight": 1,
              "description": "Track your daily transaction recording streak and 7-day activity.",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "QuickRecordWidget",
              "label": "Pip Quick Record",
              "minWidth": "110dp",
              "minHeight": "40dp",
              "targetCellWidth": 2,
              "targetCellHeight": 1,
              "description": "Quickly record income or expense with Pip.",
              "updatePeriodMillis": 0
            }
          ]
        }
      ],
      [
        "expo-audio",
        {
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ]
    ]
  }
}
